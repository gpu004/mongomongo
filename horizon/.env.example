# Copy to .env (git-ignored) and fill in. Never commit real values.
# Controller-only Atlas database user (readWrite on MONGODB_DB), not an Atlas admin key.
# Atlas requires TLS (mongodb+srv enables it) and the controller's egress IP in the access list.
MONGODB_URI=mongodb+srv://<controller-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# horizon_dev for development; integration tests use their own horizon_test_* databases.
MONGODB_DB=horizon_dev
# Integration tests only (needs a replica set for transactions), e.g. a local rs0 container.
MONGODB_TEST_URI=
# Pi worker model key ("worker": "pi").
ANTHROPIC_API_KEY=
# Optional hosted memory; without it the local memory adapter is used.
SUPERMEMORY_API_KEY=
