# Copy to .env (git-ignored) and export before running horizon. Never commit real values.

# MongoDB Atlas development cluster (plan.md §1). The URI carries the controller
# database user's credentials; use a user scoped to the application database and
# allow the controller's outbound IP in the Atlas IP access list.
# Transactions require a replica set (every Atlas cluster is one).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=horizon
# Database name; defaults to horizon_dev. Use a separate name for integration test runs.
MONGODB_DB=horizon_dev

# Supermemory hosted retrieval (optional; the local memory adapter is used without it).
SUPERMEMORY_API_KEY=

# Model provider key for the Pi worker ("worker": "pi"), named <PROVIDER>_API_KEY.
ANTHROPIC_API_KEY=
