# Copy to .env and export before running `horizon`. Never commit .env.

# MongoDB ledger backend (missions with "ledger": { "backend": "mongodb" }).
# Any replica set works: an Atlas development cluster or a local single-node replica set.
# Credentials are redacted in `horizon doctor` output and never written to the ledger.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name; a mission's "ledger.database" overrides it. Default: horizon
MONGODB_DB=horizon

# Tests: run the MongoDB contract tests against this cluster instead of a Docker replica set.
# HORIZON_TEST_MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
# Skip Docker-dependent tests (MongoDB replica set, sandboxed exec) on hosts without Docker.
# HORIZON_SKIP_DOCKER_TESTS=1

# Optional hosted memory adapter; without it the local adapter is used.
# SUPERMEMORY_API_KEY=
