{
  "name": "horizon",
  "version": "0.1.0",
  "private": true,
  "description": "Pi + Supermemory long-running agent harness: verifies, remembers, and materializes corrections.",
  "bin": {
    "horizon": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "horizon": "node src/cli.ts",
    "check": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "seed:serve": "node demo/search-service/src/http/server.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "mongodb": "7.6.0",
    "supermemory": "4.25.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24"
  }
}
