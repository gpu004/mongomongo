{
  "schemaVersion": 1,
  "scenarioId": "delete-removes-from-results",
  "suite": "correctness",
  "description": "A deleted document never appears again, even for a query that was answered before the delete.",
  "invariantIds": ["INV-DELETE-VISIBILITY"],
  "sequence": [
    {
      "op": "insert",
      "id": "del-1",
      "title": "Temporary",
      "body": "remove me"
    },
    {
      "op": "insert",
      "id": "keep-1",
      "title": "Temporary",
      "body": "keep me"
    },
    {
      "op": "search",
      "q": "temporary"
    },
    {
      "op": "delete",
      "id": "del-1"
    },
    {
      "op": "search",
      "q": "temporary"
    },
    {
      "op": "delete",
      "id": "del-1"
    },
    {
      "op": "search",
      "q": "remove"
    }
  ],
  "example": "DELETE /documents/del-1 then GET /search?q=temporary -> {ids:[\"keep-1\"]}"
}
