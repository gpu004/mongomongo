{
  "schemaVersion": 1,
  "scenarioId": "insertion-order-and-limit",
  "suite": "correctness",
  "description": "Results are in insertion order and truncated to limit; limit 0 returns nothing.",
  "invariantIds": [
    "INV-RESULT-ORDER",
    "INV-LIMIT"
  ],
  "sequence": [
    {
      "op": "insert",
      "id": "z",
      "title": "common",
      "body": "1"
    },
    {
      "op": "insert",
      "id": "a",
      "title": "common",
      "body": "2"
    },
    {
      "op": "insert",
      "id": "m",
      "title": "common",
      "body": "3"
    },
    {
      "op": "search",
      "q": "common"
    },
    {
      "op": "search",
      "q": "common",
      "limit": 2
    },
    {
      "op": "search",
      "q": "common",
      "limit": 0
    }
  ],
  "example": "GET /search?q=common&limit=2 -> {ids:[\"z\",\"a\"]}"
}
